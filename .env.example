# Replace the neutral interface label only when branding is approved.
# Contact links and their surrounding copy stay hidden until a real address is configured.
CONTACT_EMAIL=

# Isolated, non-persistent demo adapter. Never receives or sends email.
# Production fails closed unless demo behavior is explicitly enabled for preview.
REQUEST_SUBMISSION_MODE=demo
ALLOW_DEMO_SUBMISSIONS=false

# Phase 1 persistence remains closed unless both values below are exact.
# Do not enable public non-demo submissions before later abuse-control and
# production-readiness phases are complete.
ENABLE_PERSISTENT_SUBMISSIONS=false
# Use the managed provider's pooled/serverless-safe endpoint where applicable.
DATABASE_URL=
DATABASE_POOL_MAX=5

# Migration-only credentials; the runtime DATABASE_URL role should not own DDL.
DATABASE_MIGRATION_URL=

# Dedicated disposable database used only by `npm run test:db`.
TEST_DATABASE_URL=
