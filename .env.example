# Replace the neutral interface label only when branding is approved.
# Contact links and their surrounding copy stay hidden until a real address is configured.
CONTACT_EMAIL=

# Isolated, non-persistent demo adapter. Never receives or sends email.
# Production fails closed unless demo behavior is explicitly enabled for preview.
REQUEST_SUBMISSION_MODE=demo
ALLOW_DEMO_SUBMISSIONS=false

# Phase 1 persistence remains closed unless both values below are exact.
# Do not enable public non-demo submissions before later abuse-control and
# production-readiness phases are complete.
ENABLE_PERSISTENT_SUBMISSIONS=false
# Use the managed provider's pooled/serverless-safe endpoint where applicable.
DATABASE_URL=
DATABASE_POOL_MAX=5

# Public persistence has an additional, independent abuse-control gate. This
# repository intentionally registers no production rate-limit provider yet, so
# these values cannot enable persistence on their own.
RATE_LIMIT_PROVIDER=
# Optional Phase 5A public origin resistance; disabled until the manual edge
# runbook is executed. Exact values: disabled|required. Empty/unknown denies.
# required needs Vercel production plus Cloudflare's server-side Set static
# x-limitmark-origin-secret transform on BOTH public hosts. Never a response,
# cookie, URL parameter, NEXT_PUBLIC variable, or deployment-protection bypass.
PUBLIC_ORIGIN_PROTECTION=disabled
# Independent 32 random bytes encoded as unpadded base64url; never reuse the
# client-key HMAC secret. Do not populate production credentials in this file.
PUBLIC_ORIGIN_SECRET=
# The only implemented IP trust policy is Vercel with no upstream proxy. It
# reads Vercel's platform-set x-vercel-forwarded-for copy and ignores arbitrary
# forwarding headers. VERCEL=1 and VERCEL_ENV=production must both be supplied
# by Vercel; preview/development deployments remain closed.
# Only SUBMISSION_CLIENT_IP_SOURCE=vercel is supported. Cloudflare identity is
# deliberately unsupported; required origin protection independently closes
# public persistence. See PHASE5A_EDGE_RUNBOOK.md before proxying public DNS.
SUBMISSION_CLIENT_IP_SOURCE=
# 32 random bytes encoded as unpadded base64url (43 characters), server-only.
SUBMISSION_CLIENT_KEY_SECRET=

# Turnstile remains off until a real Managed widget, hostname restriction and
# separate production keys are configured. The secret is server-only.
TURNSTILE_MODE=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Migration-only credentials; the runtime DATABASE_URL role should not own DDL.
DATABASE_MIGRATION_URL=

# Dedicated disposable database used only by `npm run test:db`.
TEST_DATABASE_URL=

# Phase 2B notification delivery remains off unless this exact gate is enabled.
# Configure a verified Resend sender and an internal recipient. Keep the API key secret.
ENABLE_REAL_NOTIFICATIONS=false
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=

# Phase 3 internal admin authentication. All values are server-only and required;
# missing/malformed values or an empty/invalid/duplicate allowlist deny all access.
# Use the exact HTTPS team origin and Access application's AUD tag.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Comma-separated exact mailboxes. Do not use domains or patterns.
ADMIN_ALLOWED_EMAILS=
