# Replace the neutral interface label only when branding is approved.
# Contact links and their surrounding copy stay hidden until a real address is configured.
CONTACT_EMAIL=

# Isolated, non-persistent demo adapter. Never receives or sends email.
# ALLOW_DEMO_SUBMISSIONS may enable an intentional local/Preview production-build
# demo, but Vercel Production always ignores it and fails closed.
REQUEST_SUBMISSION_MODE=demo
ALLOW_DEMO_SUBMISSIONS=false
# Exact browser Origin accepted by the non-persistent local demo Route Handler.
PUBLIC_DEMO_ORIGIN=http://localhost:3000

# Public intake remains closed unless both values below are exact. These values
# do not control admin database availability; DATABASE_URL does that separately.
# Do not enable public submissions before every abuse-control gate is ready.
ENABLE_PERSISTENT_SUBMISSIONS=false
# Use the managed provider's pooled/serverless-safe endpoint where applicable.
DATABASE_URL=
DATABASE_POOL_MAX=5

# I1 implements only the reviewed single Cloudflare DO authority. The runtime
# registry intentionally remains empty, so these values cannot enable real
# persistence during this implementation/review phase.
RATE_LIMIT_PROVIDER=
# The selected future value is cloudflare-do. No Redis/Upstash/MemoryDB fallback.

# Existing purpose-separated origin bearer. Production signed ingress requires
# exact required mode; preview/development and unknown values cannot persist.
PUBLIC_ORIGIN_PROTECTION=disabled
# Independent 32 random bytes as unpadded base64url. Never reuse any key below.
PUBLIC_ORIGIN_SECRET=

# Public and admin routes share one Production Vercel project P. Its system
# variables remain enabled and identify the exact Production project/deployment.
# Vercel may inject P's selected B-public value; it is never NEXT_PUBLIC or
# application authorization. B-admin is configured only on the admin gateway.
VERCEL_PROJECT_ID=
VERCEL_DEPLOYMENT_ID=
# Fixed protocol literal and a JSON array containing a current key and optional
# next key with explicit activation/retirement times. Public keys are not secrets.
INGRESS_PROTOCOL=lm-ingress-v1
INGRESS_AUDIENCE=
INGRESS_PUBLIC_KEYS=
# Separate server-only 256-bit HMAC key for opaque request bindings.
INGRESS_REQUEST_BINDING_KEY=

# Narrow Vercel -> admission service boundary. The URL and OIDC audience are
# fixed policy. Release ID must exactly equal VERCEL_DEPLOYMENT_ID.
ADMISSION_SERVICE_URL=
ADMISSION_OIDC_AUDIENCE=
ADMISSION_RELEASE_ID=
ADMISSION_RELEASE_KEY_ID=
# Separate release-specific 256-bit RPC MAC key. Never present at the signer.
ADMISSION_RELEASE_RPC_KEY=

# Worker-only Ed25519 signing, address-pseudonym HMAC and offline operator private
# keys are never accepted by the Next.js runtime. B-public may be platform-injected;
# B-admin must not be deliberately configured as an application environment value.

# Turnstile remains off until a real Managed widget, hostname restriction and
# separate production keys are configured. The secret is server-only.
TURNSTILE_MODE=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Migration-only credentials; the runtime DATABASE_URL role should not own DDL.
DATABASE_MIGRATION_URL=

# Dedicated disposable database. `npm run test:db` may skip without it;
# `npm run test:db:required` fails unless it is present, then runs every DB test.
TEST_DATABASE_URL=

# Phase 2B notification delivery remains off unless this exact gate is enabled
# on Vercel Production. Preview/development cannot use copied delivery credentials.
# Configure a verified Resend sender and an internal recipient. Keep the API key secret.
ENABLE_REAL_NOTIFICATIONS=false
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=

# Phase 3 internal admin authentication. All values are server-only and required;
# missing/malformed values or an empty/invalid/duplicate allowlist deny all access.
# Use the exact HTTPS team origin and Access application's AUD tag.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Comma-separated exact mailboxes. Do not use domains or patterns.
ADMIN_ALLOWED_EMAILS=
