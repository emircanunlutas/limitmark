{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "limitmark-r06-pre2c-attestation-rpc-transport-test",
  "main": "workers/attestation-rpc-transport-harness.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "AUTHORITY_PRODUCTION", "class_name": "TransportProductionAuthority" },
      { "name": "AUTHORITY_STAGING", "class_name": "TransportStagingAuthority" }
    ]
  },
  "migrations": [
    { "tag": "local-attestation-transport-v1", "new_sqlite_classes": ["TransportProductionAuthority", "TransportStagingAuthority"] }
  ]
}
