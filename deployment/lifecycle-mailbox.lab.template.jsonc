{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "limitmark-lifecycle-mailbox-lab",
  "main": "__REQUIRED_RENDERED_LAB_MAILBOX_MAIN__.ts",
  "account_id": "__REQUIRED_CLOUDFLARE_ACCOUNT_ID__",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "r2_buckets": [
    { "binding": "REQUEST_BUCKET", "bucket_name": "limitmark-lifecycle-requests-lab" },
    { "binding": "RESULT_BUCKET", "bucket_name": "limitmark-lifecycle-results-lab" }
  ],
  "durable_objects": { "bindings": [{ "name": "DISPATCH_GUARD", "class_name": "LabLifecycleDispatchGuard" }] },
  "migrations": [{ "tag": "lab-guard-v1", "new_sqlite_classes": ["LabLifecycleDispatchGuard"] }],
  "services": [
    { "binding": "LIFECYCLE_EXECUTOR", "service": "limitmark-authority-operator-executor-lab", "entrypoint": "LabOperatorLifecycleExecutor" },
    { "binding": "LIFECYCLE_READER", "service": "limitmark-admission-service-lab", "entrypoint": "LabAuthorityLifecycleReadOnly" }
  ],
  "vars": {
    "AUTHORITY_OPERATOR_PUBLIC_KEY": "__REQUIRED_LAB_OPERATOR_ED25519_PUBLIC_KEY__",
    "LIFECYCLE_ENVIRONMENT": "lab"
  }
}
