{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "limitmark-lifecycle-observer-production",
  "main": "__REQUIRED_RENDERED_OBSERVER_MAIN__.ts",
  "account_id": "__REQUIRED_CLOUDFLARE_ACCOUNT_ID__",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [
    { "binding": "REQUEST_BUCKET", "bucket_name": "limitmark-lifecycle-requests-production" },
    { "binding": "RESULT_BUCKET", "bucket_name": "limitmark-lifecycle-results-production" }
  ],
  "services": [
    { "binding": "LIFECYCLE_READER", "service": "limitmark-admission-service-production", "entrypoint": "AuthorityLifecycleReadOnly" }
  ]
}
