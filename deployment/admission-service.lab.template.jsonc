{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "limitmark-admission-service-lab",
  "main": "../workers/admission-service/lab-index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lab-admission.limitmark.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AUTHORITY", "class_name": "LabAdmissionAuthority" }
    ]
  },
  "migrations": [
    { "tag": "lab-admission-v1", "new_sqlite_classes": ["LabAdmissionAuthority"] }
  ],
  "vars": {
    "ADMISSION_IDENTITY_MODE": "google-lab",
    "GOOGLE_OIDC_ISSUER": "https://accounts.google.com",
    "GOOGLE_OIDC_AUDIENCE": "https://lab-admission.limitmark.com",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL": "__REQUIRED_LAB_CLOUD_RUN_SERVICE_ACCOUNT__",
    "GOOGLE_SERVICE_ACCOUNT_SUBJECT": "__REQUIRED_LAB_CLOUD_RUN_SERVICE_ACCOUNT_SUBJECT__",
    "AUTHORITY_OPERATOR_PUBLIC_KEY": "__REQUIRED_LAB_OPERATOR_ED25519_PUBLIC_KEY__",
    "ADMISSION_CURRENT_RELEASE_ID": "__REQUIRED_LAB_RELEASE_ID__",
    "ADMISSION_CURRENT_KEY_ID": "__REQUIRED_LAB_RELEASE_KEY_ID__",
    "ADMISSION_CURRENT_ACTIVATED_AT_MS": "__REQUIRED_LAB_ACTIVATION_TIME_MS__"
  }
}
